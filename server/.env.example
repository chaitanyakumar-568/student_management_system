# ---- Server ----
PORT=5000
NODE_ENV=development

# ---- Database ----
# Local:  mongodb://127.0.0.1:27017/student_management
# Atlas:  mongodb+srv://<db_user>:<db_password>@<cluster>.mongodb.net/student_management?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/student_management

# ---- Auth ----
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=91c1fdc0b2fe7ee440f76dd807142bbdaffa9c823f2c985df7b47c5c8a112bd18cbf158a3551f4efed44b01ba502d5e66bb410ea0023c76cf66523e8f36f69d8
JWT_EXPIRES_IN=1d

# ---- CORS / cookies ----
# Exact origin of the React app (no trailing slash)
CLIENT_URL=http://localhost:5173
# Set to "none" ONLY if frontend and API are on different sites in production (requires HTTPS).
# Default: "lax" in development, "strict" in production.
# COOKIE_SAMESITE=lax

# Set to "true" when running behind a reverse proxy / load balancer (Render, Heroku, Nginx...)
# TRUST_PROXY=false

# ---- Admin seed (used ONLY by `npm run seed:admin`) ----
ADMIN_NAME=chaitanya
ADMIN_EMAIL=chaitu@gmail.com
ADMIN_PASSWORD=chaitu@123
